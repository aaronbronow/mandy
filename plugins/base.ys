!ys-0

defn heading?(line):
  re-matches(qr"[A-Z][A-Z0-9()\s]*[A-Z0-9)]", trim(line))

defn parse-man(raw-text):
  let lines: split-lines(raw-text)
      indexed-lines: map-indexed(vector, lines):
    reduce(fn [acc [idx line]]:
      if heading?(line):
        conj(acc, {(trim line): []})
        let [last-idx: dec(count(acc))
             heading: first(keys(nth(acc, last-idx)))
             lm: {:originalIndex idx, :text line}]:
          update-in(acc, [last-idx, heading], conj, lm))
      [{"PREFACE": []}]
      indexed-lines)

# Main entry point for the plugin
parse-man(input-text)
