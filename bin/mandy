#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
UBERJAR="$REPO_ROOT/target/mandy-0.1.0-standalone.jar"

export MANDY_ROOT="${MANDY_ROOT:-$REPO_ROOT}"

if [[ -f "$UBERJAR" ]]; then
  exec java -jar "$UBERJAR" "$@"
else
  exec clojure -M -m mandy.main "$@"
fi
